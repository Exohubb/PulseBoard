# =============================================================================
# PulseBoard environment template
#
# Copy to `.env` (root) AND `apps/api/.env` for local dev.
# In production (Render/etc), set these in your host's environment, not files.
# =============================================================================

# --- Database (PostgreSQL) ---
# Local dev with the included docker-compose:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pulseboard?schema=public"
# Production examples:
#   Render:    Use the "Internal Database URL" from the Render dashboard.
#   Supabase:  Use the connection pooler URL (port 6543) for serverless,
#              or the direct URL (port 5432) for long-running servers.
#   Neon:      Append ?sslmode=require to the URL.

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- Authentication ---
# REQUIRED in production. Generate with: openssl rand -hex 48
# The API will refuse to start if this is unset/weak when NODE_ENV=production.
JWT_SECRET="change-me-locally-this-must-be-at-least-32-characters-long"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# --- Application ---
NODE_ENV="development"
APP_URL="http://localhost:5173"
API_URL="http://localhost:4000"
# Render injects PORT automatically; API_PORT is the local-dev fallback.
API_PORT=4000

# --- CORS ---
# Comma-separated list of allowed origins for the API.
# In production: include your Vercel URL, e.g. https://pulseboard.vercel.app
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# --- SMTP (optional, for email alerts) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="PulseBoard <noreply@pulseboard.dev>"

# --- Slack (optional fallback webhook) ---
SLACK_WEBHOOK_URL=""

# --- Scanner limits ---
SCANNER_MAX_DURATION_MS=30000
SCANNER_MAX_MESSAGES=50
SCANNER_MAX_PAYLOAD_SIZE=1024

# --- Scheduler ---
SCHEDULER_LOCK_TTL_MS=30000
SCHEDULER_TICK_INTERVAL_MS=10000

# --- Rate limiting ---
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# --- Retention ---
CHECK_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=90

# =============================================================================
# Frontend env vars (set on Vercel, NOT here):
#   VITE_API_URL    = https://<your-render-app>.onrender.com/api
#   VITE_SOCKET_URL = https://<your-render-app>.onrender.com
# =============================================================================